# Color scripts embed byte-exact terminal payloads. Git must not rewrite their line endings;
# some families intentionally use LF while Botany retains source CRLF sequences.
ColorScripts-Enhanced/Scripts/*.ps1 -text whitespace=-blank-at-eol

# Generated provenance evidence is compared byte-for-byte across supported platforms.
audit/ArtworkHeaderMigration.json -text
audit/ArtworkProvenance.psd1 -text
docs/assets/artwork-provenance.json -text

# Botany scripts embed byte-exact ANSI source data, including CRLFs and trailing spaces.
ColorScripts-Enhanced/Scripts/botany-*.ps1 -text whitespace=-blank-at-eol

# os-ansi scripts embed LF-only terminal streams whose line-feed behavior affects geometry.
ColorScripts-Enhanced/Scripts/os-ansi-*.ps1 -text whitespace=-blank-at-eol

# The Asciiville wordmark is also an LF-only preformatted terminal stream.
ColorScripts-Enhanced/Scripts/asciiville-*.ps1 -text whitespace=-blank-at-eol

# Durdraw's native ANSI example is an LF-only 80-column stream.
ColorScripts-Enhanced/Scripts/durdraw-*.ps1 -text whitespace=-blank-at-eol

# 16colors conversions may retain background-colored spaces through the right edge.
ColorScripts-Enhanced/Scripts/16c-*.ps1 whitespace=-blank-at-eol

# Roy/SAC conversions may likewise retain source-cell spaces through the right edge.
ColorScripts-Enhanced/Scripts/roy-sac-*.ps1 whitespace=-blank-at-eol
